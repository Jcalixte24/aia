{
  "cleanUrls": true,
  "redirects": [
    { "source": "/qui-sommes-nous", "destination": "/#missions", "permanent": false },
    { "source": "/qui-sommes-nous/", "destination": "/#missions", "permanent": false },
    { "source": "/activites", "destination": "/#activites", "permanent": false },
    { "source": "/activites/", "destination": "/#activites", "permanent": false },
    { "source": "/evenements", "destination": "/#evenements", "permanent": false },
    { "source": "/evenements/", "destination": "/#evenements", "permanent": false },
    { "source": "/actualites", "destination": "/#journal", "permanent": false },
    { "source": "/actualites/", "destination": "/#journal", "permanent": false },
    { "source": "/actualites/:slug", "destination": "/#journal", "permanent": false },
    { "source": "/actualites/:slug/", "destination": "/#journal", "permanent": false },
    { "source": "/galerie", "destination": "/#activites", "permanent": false },
    { "source": "/galerie/", "destination": "/#activites", "permanent": false },
    { "source": "/partenaires", "destination": "/#partenaires", "permanent": false },
    { "source": "/partenaires/", "destination": "/#partenaires", "permanent": false },
    { "source": "/support", "destination": "/#rejoindre", "permanent": false },
    { "source": "/support/", "destination": "/#rejoindre", "permanent": false },
    { "source": "/contact", "destination": "/#rejoindre", "permanent": false },
    { "source": "/contact/", "destination": "/#rejoindre", "permanent": false },
    { "source": "/rejoindre", "destination": "/#rejoindre", "permanent": false },
    { "source": "/rejoindre/", "destination": "/#rejoindre", "permanent": false },
    { "source": "/en", "destination": "/", "permanent": false },
    { "source": "/en/:path*", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" }
  ],
  "headers": [
    {
      "source": "/admin(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://aia-ci-default-rtdb.europe-west1.firebasedatabase.app; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" }
      ]
    },
    {
      "source": "/(cms.js|cms-config.js|content-default.json|eclipse.js|eclipse.css|eclipse-core.js)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
